{
  "name": "collab-editor-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API and WebSocket gateway for the Real-Time Collaborative Document Editor",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "migrate": "node src/db/migrate.js",
    "test:reset-db": "node --import ./tests/env.setup.js src/db/resetTestDb.js",
    "pretest": "npm run test:reset-db",
    "test": "node --import ./tests/env.setup.js --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "pino-pretty": "^11.2.2",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
