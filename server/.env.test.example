# Copy to server/.env.test and point DATABASE_URL at a disposable database
# whose name contains "test" (resetTestDb.js refuses to run against anything
# else). The other values just need to satisfy config.js's required-var
# validation for scripts/tests that import it (pool.js -> config.js) — they
# don't need to be real secrets for a local test run.
#
# The Docker Compose postgres service is exposed on localhost:5432, so create
# the test database once with:
#   docker compose exec postgres psql -U collab_editor -d collab_editor -c "CREATE DATABASE collab_editor_test;"
DATABASE_URL=postgresql://collab_editor:changeme_dev_only@localhost:5432/collab_editor_test
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=test_access_secret
JWT_REFRESH_SECRET=test_refresh_secret
