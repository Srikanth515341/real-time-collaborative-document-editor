# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database
POSTGRES_USER=collab_editor
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=collab_editor
DATABASE_URL=postgresql://collab_editor:changeme_dev_only@postgres:5432/collab_editor

# Auth (placeholder values only — never commit real secrets)
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Client (Vite exposes only VITE_-prefixed vars to the browser)
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
